[init]
	defaultBranch = main

[core]
	; Use the shared Neovim server when it is running; nvim-edit falls back to
	; a blocking local editor, which is what Git requires.
	editor = nvim-edit
	autocrlf = input


##### Sync behavior

[pull]
	rebase = false

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true


##### Diffs and merges

[diff]
	colorMoved = default
	tool = codediff

[merge]
	conflictstyle = zdiff3
	tool = codediff

[difftool "codediff"]
	cmd = nvim \"$LOCAL\" \"$REMOTE\" -c \"lua require('lazyload').codediff()\" +\"CodeDiff file $LOCAL $REMOTE\"

[mergetool]
	keepBackup = false

[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"lua require('lazyload').codediff()\" -c \"CodeDiff merge \\\"$MERGED\\\"\"
	trustExitCode = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate


##### Identity and signing

[user]
	name = Vasco Nunes
	email = contact@vasco.dev
	signingkey = A5EB75AD5B1D0E211E9FDE6121F9288BCED1AF2C

[commit]
	gpgsign = true
	verbose = true

[tag]
	gpgsign = true
	forceSignAnnotated = true

[gpg]
	program = /opt/homebrew/bin/gpg


##### Local and context-specific config

[includeIf "gitdir:~/repos/**"]
	path = ~/repos/.gitconfig

[include]
	path = ~/.gitconfig.local


##### Credentials

[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
