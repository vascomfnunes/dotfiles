##### XDG paths and editor

export ZDOTDIR="$HOME/.config/zsh"
export PATH="$HOME/.local/bin:$PATH"

# One Neovim server per user when started with --listen. `v` hands files to it
# without blocking; `nvim-edit` falls back to a normal editor otherwise.
export NVIM_SERVER="${TMPDIR:-/tmp}/nvim-${USER:-$(id -u)}.sock"

# Blocking by default because Git and other $EDITOR callers expect the editor
# to return only after the file is closed.
export EDITOR="nvim-edit"
export VISUAL="nvim-edit"


##### Tool defaults

export HOMEBREW_AUTO_UPDATE_SECS="86400"
export BAT_THEME="ansi"


##### Search and pager defaults

export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
export FZF_DEFAULT_OPTS="--height 40% --reverse"
# Only replace the default pager when bat is available, so man keeps
# working on machines where the Brewfile has not been installed yet.
if command -v bat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi
