##### Host-specific overrides

# Git hosting services can cap sessions carried by one multiplexed connection.
# Git operations that share a master can exhaust it and fail with
# "mux_client_request_session: session request failed: Session open refused by
# peer". The cap is server-side and cannot be raised from the client, so use a
# dedicated connection for these hosts instead.
Host github.com bitbucket.org
  ControlMaster no
  ControlPath none


##### macOS keychain integration

Host *
  # IgnoreUnknown keeps this portable across OpenSSH builds without Apple's
  # keychain-specific options.
  IgnoreUnknown AddKeysToAgent,UseKeychain
  AddKeysToAgent yes
  UseKeychain yes

  # Detect dead connections instead of hanging forever.
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Reuse one connection per host so repeat sessions skip the handshake.
  # The sockets directory is created by install.sh. %C hashes user, host,
  # and port so long hostnames stay under the socket path length limit.
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m
