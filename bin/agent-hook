#!/bin/sh

# Translate a Codex or Claude Code lifecycle hook into agent-status calls.
# Usage: agent-hook <codex|claude> <begin|done|clear>
#
# The hook runner supplies a JSON object on stdin. The pane is taken from
# TMUX_PANE when available; the hook payload's cwd helps agent-status locate
# the pane when it is not.

set -eu

agent=${1:-}
state=${2:-}

case "$agent" in
  claude|codex) ;;
  *) exit 0 ;;
esac
case "$state" in
  begin|done|clear) ;;
  *) exit 0 ;;
esac

payload=$(cat 2>/dev/null || true)
workdir="${PWD:-$HOME}"

if [ -n "$payload" ] && command -v jq >/dev/null 2>&1; then
  payload_cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)
  if [ -n "$payload_cwd" ]; then
    workdir=$payload_cwd
  fi
fi

helper=${AGENT_STATUS_BIN:-$HOME/.local/bin/agent-status}
[ -x "$helper" ] || exit 0

set -- "$state" --agent "$agent" --path "$workdir"
if [ -n "${TMUX_PANE:-}" ]; then
  set -- "$@" --pane "$TMUX_PANE"
fi

"$helper" "$@" >/dev/null 2>&1 || true
exit 0
