##### Font and theme

theme = "light:Catppuccin Latte,dark:Catppuccin Mocha"
font-thicken = true
# Disable programming ligatures such as != and =>.
font-feature = -calt


##### Cursor and shell integration

cursor-style-blink = true
shell-integration-features = no-cursor
confirm-close-surface = false
mouse-hide-while-typing = true


##### Notifications

# Notify when a command that ran for at least 10 seconds finishes while the
# surface is in the background. Commands inside tmux are covered separately by
# the agent-status helper.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s


##### Window appearance

macos-icon = xray


##### Key bindings

# Send Option+hjkl as Alt (Esc-prefixed) for tmux/nvim pane resizing
keybind = alt+h=esc:h
keybind = alt+j=esc:j
keybind = alt+k=esc:k
keybind = alt+l=esc:l
