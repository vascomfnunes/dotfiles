##### Font and theme

theme = "light:Catppuccin Latte,dark:Catppuccin Mocha"
font-thicken = true
# Disable programming ligatures such as != and =>.
font-feature = -calt


##### Cursor and shell integration

# Launch Herdr in the first Ghostty surface on startup, falling back to a login
# shell when detaching or if Herdr is unavailable. Subsequent windows and the
# quick terminal still open a normal Zsh shell.
initial-command = /bin/zsh -l -c 'if command -v herdr >/dev/null 2>&1; then herdr; fi; exec /bin/zsh -l'

cursor-style-blink = true
shell-integration-features = no-cursor
# Always confirm before closing a surface or quitting, even when idle.
confirm-close-surface = always
mouse-hide-while-typing = true


##### Notifications

# Notify when a command that ran for at least 10 seconds finishes while the
# surface is in the background.
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 5s


##### Window appearance

macos-icon = xray
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
# Restore windows, tabs, and splits when Ghostty restarts.
window-save-state = always


##### Splits

# Keep the focused split clear without making the others too dark.
unfocused-split-opacity = 0.85
# Move the zoomed state with focus instead of unzooming on navigation.
split-preserve-zoom = navigation


##### Key bindings

# Send Option as Alt so Alt+hjkl resize bindings reach Herdr and Neovim.
macos-option-as-alt = true

# Tabs, splits, and Neovim-aware pane navigation/resizing are handled by Herdr
# (~/.config/herdr/config.toml), so Ghostty multiplexer keybindings are omitted.


##### Quick terminal

# Dropdown terminal that slides in from the top of the screen (the default
# position). `global:` makes the key work from any application, which needs
# Ghostty granted macOS Accessibility permission.
keybind = global:cmd+backquote=toggle_quick_terminal

# Height on the primary axis; the width stays maximized. Percentages scale
# with the display, unlike a fixed pixel height.
quick-terminal-size = 40%
